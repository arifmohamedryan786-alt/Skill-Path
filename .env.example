# SkillPath Environment Configuration
# Copy this file to .env and configure as needed

# Secret Key for JWT Token Generation and cryptographic operations
SECRET_KEY=skillpath_production_jwt_secret_key_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite:///./backend/skillpath.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/skillpath

# ==============================================================================
# LLM Provider Configuration
# Choose one: gemini | groq | openrouter | ollama | anthropic | openai
# Default: gemini (free tier available at https://aistudio.google.com/)
# If no provider API key is set, SkillPath automatically runs in 100% offline
# deterministic mode built from curated database rules.
# ==============================================================================
LLM_PROVIDER=gemini

# 1. Google Gemini (Free Tier: 15 RPM, 1M TPM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Ultra-fast, Free Tier: 30 RPM at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Free and Paid open models at https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Ollama (100% Local offline models - run 'ollama run llama3.2')
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 5. Anthropic (Claude models at https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 6. OpenAI (GPT-4o mini at https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & Deployment Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS: Comma-separated list of allowed frontend origins (no '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Frontend API URL (Set in Vercel environment variables to point to your deployed backend)
VITE_API_URL=http://localhost:8000
